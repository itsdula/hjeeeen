# HJEN deploy targets — copy this file to `deploy.env` and fill in the real
# values. `deploy.env` is gitignored: SSH hosts, key paths and any secret
# never go through chat or into git. Paste them here directly on your machine.
#
# Usage after filling:  ./deploy.sh staging   |   ./deploy.sh prod

# ── Staging (demo.hjen.ai) — the review environment ──────────────────────────
STAGING_SSH=ubuntu@<staging-ip-or-hostname>
# STAGING_KEY=~/.ssh/<your-key>.pem        # omit to use ssh-agent / default key
STAGING_REMOTE=/opt/hjen-server
STAGING_WEBAPP_DIST=/opt/hjen-server/webapp-dist
STAGING_SERVICE=hjen-server                # systemd service name on the box
STAGING_HEALTH=https://demo.hjen.ai/health

# ── Production (app.hjen.ai) — customers. NOT provisioned yet ─────────────────
PROD_SSH=ubuntu@<prod-ip-or-hostname>
# PROD_KEY=~/.ssh/<your-key>.pem
PROD_REMOTE=/opt/hjen-server
PROD_WEBAPP_DIST=/opt/hjen-server/webapp-dist
PROD_SERVICE=hjen-server
PROD_HEALTH=https://app.hjen.ai/health
