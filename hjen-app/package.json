{
  "name": "hjen-studio",
  "version": "0.11.0-rc.1",
  "description": "HJEN Studio \u2014 Saudi-DNA AI image and film studio",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron:build": "tsc -p electron",
    "build:web": "tsc -b && vite build",
    "build": "tsc -p electron && tsc -b && vite build && electron-builder",
    "electron:dev": "npm run electron:build && concurrently -k -n vite,electron \"vite\" \"wait-on http://localhost:5173 && env -u ELECTRON_RUN_AS_NODE VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "preview": "vite preview",
    "release": "bash build/release.sh"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "openai": "^4.73.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "ai.hjen.studio",
    "productName": "HJEN Studio",
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/appicon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "binaries": [
        "Contents/Resources/bin/ffmpeg",
        "Contents/Resources/bin/yt-dlp"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hjen-studio",
        "repo": "hjen-releases",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../extension/dist",
        "to": "extension"
      },
      {
        "from": "../../context_agents",
        "to": "context_agents"
      },
      {
        "from": "skills",
        "to": "skills"
      },
      {
        "from": "../../../.agents/skills/saudi-ad-voice",
        "to": "skills/saudi-ad-voice"
      },
      {
        "from": "worldkit",
        "to": "worldkit",
        "filter": [
          "**/*",
          "!__pycache__/**"
        ]
      },
      {
        "from": "bin",
        "to": "bin"
      }
    ]
  }
}
